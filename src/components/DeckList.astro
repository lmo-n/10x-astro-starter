---
import { createClient } from "@/lib/supabase";
import { listDecks } from "@/lib/services/deck.service";
import { listDecksQuerySchema } from "@/lib/validation/decks";
import DeckCard from "@/components/DeckCard.tsx";

const { user } = Astro.locals;

const params = Object.fromEntries([...Astro.url.searchParams].filter(([, v]) => v !== ""));
const query = listDecksQuerySchema.parse(params);

const supabase = createClient(Astro.request.headers, Astro.cookies);

let decksResult: Awaited<ReturnType<typeof listDecks>> | null = null;
let fetchError: string | null = null;

if (supabase && user) {
  try {
    decksResult = await listDecks(supabase, user.id, query);
  } catch (e) {
    fetchError = e instanceof Error ? e.message : "Failed to load decks.";
  }
}

const decks = decksResult?.data ?? [];
const pagination = decksResult?.pagination ?? { hasMore: false, nextCursor: null };
const limits = decksResult?.limits;

function buildUrl(overrides: Record<string, string | undefined>) {
  const p = new URLSearchParams(Astro.url.searchParams);
  p.delete("cursor"); // reset pagination when changing filters/sort
  for (const [k, v] of Object.entries(overrides)) {
    if (v !== undefined && v !== "") p.set(k, v);
    else p.delete(k);
  }
  return `?${p.toString()}`;
}

const sortOptions = [
  { value: "createdAt", label: "Created" },
  { value: "updatedAt", label: "Updated" },
  { value: "name", label: "Name" },
] as const;

const nextPageUrl = pagination.nextCursor
  ? (() => {
      const p = new URLSearchParams(Astro.url.searchParams);
      p.set("cursor", pagination.nextCursor);
      return `?${p.toString()}`;
    })()
  : null;
---

<!-- Deck limits bar -->{
  limits && (
    <div class="mb-6 rounded-xl border border-white/10 bg-white/5 px-4 py-3 backdrop-blur">
      <div class="flex items-center justify-between text-sm">
        <span class="text-blue-100/70">
          <span class="font-semibold text-white">{limits.deckCount}</span> / <span>{limits.deckLimit}</span> decks used
        </span>
        {!limits.canCreateDeck && (
          <span class="rounded-full bg-amber-500/20 px-2 py-0.5 text-xs text-amber-300">Deck limit reached</span>
        )}
      </div>
      <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-white/10">
        <div
          class="h-full rounded-full bg-linear-to-r from-blue-400 to-purple-400 transition-all"
          style={`width: ${Math.min((limits.deckCount / limits.deckLimit) * 100, 100)}%`}
        />
      </div>
    </div>
  )
}

<!-- Search + Sort toolbar -->
<div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center">
  <!-- Search form -->
  <form method="GET" class="flex w-full items-center gap-2 sm:flex-1">
    <input type="hidden" name="sort" value={query.sort} />
    <input type="hidden" name="order" value={query.order} />
    {query.limit !== 20 && <input type="hidden" name="limit" value={query.limit} />}

    <div class="relative flex-1">
      <input
        type="search"
        name="search"
        value={query.search ?? ""}
        placeholder="Search decks…"
        class="w-full rounded-lg border border-white/20 bg-white/10 py-2 pr-4 pl-9 text-sm text-white placeholder:text-blue-100/40 focus:ring-2 focus:ring-blue-400/50 focus:outline-none"
      />
      <svg
        class="pointer-events-none absolute top-1/2 left-3 h-4 w-4 -translate-y-1/2 text-blue-100/40"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"></path>
      </svg>
    </div>
    <button
      type="submit"
      class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm whitespace-nowrap transition-colors hover:bg-white/20"
    >
      Search
    </button>
  </form>

  <!-- Divider -->
  <div class="hidden h-6 w-px bg-white/10 sm:block"></div>

  <!-- Sort buttons -->
  <div class="flex flex-wrap items-center gap-1.5 self-start sm:self-auto">
    <span class="text-xs tracking-wide text-blue-100/40 uppercase">Sort:</span>
    {
      sortOptions.map(({ value, label }) => {
        const isActive = query.sort === value;
        const toggleOrder = isActive && query.order === "asc" ? "desc" : "asc";
        const href = buildUrl({ sort: value, order: isActive ? toggleOrder : query.order });
        return (
          <a
            href={href}
            class:list={[
              "flex items-center gap-1 rounded-lg border px-3 py-1.5 text-xs transition-colors",
              isActive
                ? "border-blue-400/50 bg-blue-500/20 text-blue-200"
                : "border-white/20 bg-white/5 text-blue-100/60 hover:bg-white/10",
            ]}
          >
            {label}
            {isActive && (
              <svg
                class:list={["h-3 w-3 transition-transform", query.order === "desc" && "rotate-180"]}
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
              </svg>
            )}
          </a>
        );
      })
    }
  </div>
</div>

<!-- Error state -->
{
  fetchError && (
    <div class="mb-6 rounded-xl border border-red-400/30 bg-red-500/10 px-4 py-3 text-sm text-red-300">
      {fetchError}
    </div>
  )
}

<!-- Deck grid -->
{
  decks.length === 0 && !fetchError ? (
    <div class="rounded-2xl border border-white/10 bg-white/5 py-16 text-center backdrop-blur">
      <p class="text-lg font-medium text-blue-100/60">
        {query.search ? `No decks matching "${query.search}"` : "No decks yet"}
      </p>
      <p class="mt-1 text-sm text-blue-100/40">
        {query.search ? "Try a different search term." : "Create your first deck to get started."}
      </p>
    </div>
  ) : (
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {decks.map((deck) => (
        <DeckCard deck={deck} client:load />
      ))}
    </div>
  )
}

<!-- Pagination -->
{
  nextPageUrl && (
    <div class="mt-8 flex justify-center">
      <a
        href={nextPageUrl}
        class="rounded-lg border border-white/20 bg-white/10 px-6 py-2 text-sm transition-colors hover:bg-white/20"
      >
        Next page
      </a>
    </div>
  )
}
