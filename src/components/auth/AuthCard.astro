---
import { cn } from "@/lib/utils";

interface Props {
  /** Centers all card content (used on the confirm-email page). */
  center?: boolean;
}

const { center = false } = Astro.props;
---

<div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
  <div
    class:list={cn(
      "w-full max-w-sm rounded-2xl border border-gray-200 bg-white p-8 text-gray-900 shadow-lg backdrop-blur-xl dark:border-white/10 dark:bg-white/10 dark:text-white",
      center && "text-center",
    )}
  >
    <slot />
  </div>
</div>
