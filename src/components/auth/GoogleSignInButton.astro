---
interface Props {
  /** Optional relative path to return to after a successful login. */
  redirectTo?: string;
  /** Visible button label. */
  label?: string;
}

const { redirectTo, label = "Continue with Google" } = Astro.props;

const href = redirectTo ? `/api/auth/google?redirectTo=${encodeURIComponent(redirectTo)}` : "/api/auth/google";
---

<a
  href={href}
  class="flex w-full items-center justify-center gap-2 rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-white/20"
>
  <svg class="h-4 w-4" viewBox="0 0 24 24" aria-hidden="true">
    <path
      fill="#EA4335"
      d="M12 10.2v3.9h5.5c-.24 1.4-1.7 4.1-5.5 4.1-3.3 0-6-2.7-6-6.1S8.7 6 12 6c1.9 0 3.1.8 3.8 1.5l2.6-2.5C16.7 3.4 14.6 2.5 12 2.5 6.8 2.5 2.6 6.7 2.6 12S6.8 21.5 12 21.5c6 0 9.4-4.2 9.4-9.1 0-.6-.07-1.1-.16-1.6H12z"
    ></path>
  </svg>
  {label}
</a>

<div class="my-4 flex items-center gap-3 text-xs text-blue-100/40">
  <span class="h-px flex-1 bg-white/10"></span>
  <span>or</span>
  <span class="h-px flex-1 bg-white/10"></span>
</div>
