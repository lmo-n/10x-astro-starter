---
import type { GetProfileResponseDto } from "@/types";

interface Props {
  data: GetProfileResponseDto;
}

const { data } = Astro.props;
const { profile, stats } = data;

const creditsPercent =
  profile.aiCreditsLimit > 0 ? Math.round((profile.aiCreditsUsed / profile.aiCreditsLimit) * 100) : 0;
---

<div class="mb-8 grid grid-cols-2 gap-3 sm:grid-cols-4">
  <!-- Decks -->
  <div class="rounded-2xl border border-gray-200 bg-gray-50 p-4 dark:border-white/10 dark:bg-white/5">
    <div
      class="mb-2 flex h-8 w-8 items-center justify-center rounded-full bg-blue-100 text-blue-600 dark:bg-blue-500/20 dark:text-blue-300"
    >
      <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M19 11H5m14 0a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2m14 0V9a2 2 0 0 0-2-2M5 11V9a2 2 0 0 1 2-2m0 0V5a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v2M7 7h10"
        ></path>
      </svg>
    </div>
    <p class="text-2xl font-bold text-gray-900 dark:text-white">{stats.deckCount}</p>
    <p class="mt-0.5 text-xs text-gray-500 dark:text-blue-100/60">
      Decks <span class="text-gray-400 dark:text-blue-100/40">/ {stats.deckLimit}</span>
    </p>
  </div>

  <!-- Total flashcards -->
  <div class="rounded-2xl border border-gray-200 bg-gray-50 p-4 dark:border-white/10 dark:bg-white/5">
    <div
      class="mb-2 flex h-8 w-8 items-center justify-center rounded-full bg-purple-100 text-purple-600 dark:bg-purple-500/20 dark:text-purple-300"
    >
      <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M9 12h6m-6 4h6m2 5H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5.586a1 1 0 0 1 .707.293l5.414 5.414a1 1 0 0 1 .293.707V19a2 2 0 0 1-2 2z"
        ></path>
      </svg>
    </div>
    <p class="text-2xl font-bold text-gray-900 dark:text-white">{stats.totalFlashcardsCount}</p>
    <p class="mt-0.5 text-xs text-gray-500 dark:text-blue-100/60">Total flashcards</p>
  </div>

  <!-- AI-created flashcards -->
  <div class="rounded-2xl border border-gray-200 bg-gray-50 p-4 dark:border-white/10 dark:bg-white/5">
    <div
      class="mb-2 flex h-8 w-8 items-center justify-center rounded-full bg-indigo-100 text-indigo-600 dark:bg-indigo-500/20 dark:text-indigo-300"
    >
      <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 1 1 7.072 0l-.548.547A3.374 3.374 0 0 0 14 18.469V19a2 2 0 1 1-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"
        ></path>
      </svg>
    </div>
    <p class="text-2xl font-bold text-gray-900 dark:text-white">{stats.aiCreatedFlashcardsCount}</p>
    <p class="mt-0.5 text-xs text-gray-500 dark:text-blue-100/60">AI-generated</p>
  </div>

  <!-- AI credits -->
  <div class="rounded-2xl border border-gray-200 bg-gray-50 p-4 dark:border-white/10 dark:bg-white/5">
    <div
      class="mb-2 flex h-8 w-8 items-center justify-center rounded-full bg-emerald-100 text-emerald-600 dark:bg-emerald-500/20 dark:text-emerald-300"
    >
      <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
      </svg>
    </div>
    <p class="text-2xl font-bold text-gray-900 dark:text-white">{profile.aiCreditsRemaining}</p>
    <p class="mt-0.5 text-xs text-gray-500 dark:text-blue-100/60">
      AI credits left <span class="text-gray-400 dark:text-blue-100/40">/ {profile.aiCreditsLimit}</span>
    </p>
    <!-- usage bar -->
    <div class="mt-2 h-1 w-full overflow-hidden rounded-full bg-gray-200 dark:bg-white/10">
      <div
        class="h-1 rounded-full bg-emerald-400 transition-all dark:bg-emerald-400"
        style={`width: ${100 - creditsPercent}%`}
      >
      </div>
    </div>
  </div>
</div>
