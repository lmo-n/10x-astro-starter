---
import SoundToggle from "@/components/SoundToggle";
import ThemeToggle from "@/components/ThemeToggle";

interface Props {
  email?: string;
  avatarUrl?: string | null;
}

const { email, avatarUrl } = Astro.props;
---

<div class="mb-8 flex flex-wrap items-start justify-between gap-4 sm:items-center">
  <div class="flex items-center gap-3">
    <span
      class="inline-flex h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-full border border-gray-200 bg-gray-100 text-gray-500 shadow-sm dark:border-white/15 dark:bg-white/10 dark:text-blue-100/70"
      aria-label="User avatar"
    >
      {
        avatarUrl ? (
          <img src={avatarUrl} alt="User avatar" class="h-full w-full object-cover" referrerpolicy="no-referrer" />
        ) : (
          <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15.75 7.5a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.5 20.25a7.5 7.5 0 0115 0"
            />
          </svg>
        )
      }
    </span>
    <div>
      <p class="mb-0.5 text-xs font-semibold tracking-widest text-purple-600 uppercase dark:text-purple-400">
        10x Flashcards
      </p>
      <h1
        class="bg-linear-to-r from-blue-600 to-purple-600 bg-clip-text text-2xl font-bold text-transparent sm:text-3xl dark:from-blue-200 dark:to-purple-200"
      >
        Dashboard
      </h1>
      <p class="mt-1 text-sm text-gray-500 dark:text-blue-100/60">
        Welcome back, <span class="font-medium text-gray-800 dark:text-blue-100">{email}</span>
      </p>
    </div>
  </div>
  <div class="flex items-center gap-2">
    <span class="inline-flex h-8.5 w-8.5 items-center justify-center">
      <SoundToggle client:only="react" />
    </span>
    <span class="inline-flex h-8.5 w-8.5 items-center justify-center">
      <ThemeToggle client:only="react" />
    </span>
    <a
      href="/ai-history"
      class="inline-flex items-center gap-1.5 rounded-lg border border-gray-300 bg-gray-100 px-4 py-2 text-sm text-gray-700 transition-colors hover:border-purple-300 hover:bg-purple-50 hover:text-purple-700 dark:border-white/20 dark:bg-white/10 dark:text-white dark:hover:bg-purple-500/20 dark:hover:text-purple-200"
    >
      <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 1 1 7.072 0l-.548.547A3.374 3.374 0 0 0 14 18.469V19a2 2 0 1 1-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"
        ></path>
      </svg>
      AI history
    </a>
    <form method="POST" action="/api/auth/signout">
      <button
        type="submit"
        class="cursor-pointer rounded-lg border border-gray-300 bg-gray-100 px-4 py-2 text-sm text-gray-700 transition-colors hover:border-red-400/60 hover:bg-red-500/20 hover:text-red-500 dark:border-white/20 dark:bg-white/10 dark:text-white dark:hover:text-red-300"
      >
        Sign out
      </button>
    </form>
  </div>
</div>
