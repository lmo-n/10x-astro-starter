---
interface Props {
  email?: string;
}

const { email } = Astro.props;
---

<div class="mb-8 flex flex-wrap items-start justify-between gap-4 sm:items-center">
  <div>
    <h1 class="bg-linear-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent sm:text-3xl">
      Dashboard
    </h1>
    <p class="mt-1 text-sm text-blue-100/60">
      Welcome back, <span class="font-medium text-blue-100">{email}</span>
    </p>
  </div>
  <form method="POST" action="/api/auth/signout">
    <button
      type="submit"
      class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
    >
      Sign out
    </button>
  </form>
</div>
