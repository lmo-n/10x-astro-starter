---
import ThemeToggle from "@/components/ThemeToggle";

interface Props {
  email?: string;
}

const { email } = Astro.props;
---

<div class="mb-8 flex flex-wrap items-start justify-between gap-4 sm:items-center">
  <div>
    <h1
      class="bg-linear-to-r from-blue-600 to-purple-600 bg-clip-text text-2xl font-bold text-transparent sm:text-3xl dark:from-blue-200 dark:to-purple-200"
    >
      Dashboard
    </h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-blue-100/60">
      Welcome back, <span class="font-medium text-gray-800 dark:text-blue-100">{email}</span>
    </p>
  </div>
  <div class="flex items-center gap-2">
    <ThemeToggle client:load />
    <form method="POST" action="/api/auth/signout">
      <button
        type="submit"
        class="cursor-pointer rounded-lg border border-gray-300 bg-gray-100 px-4 py-2 text-sm text-gray-700 transition-colors hover:border-red-400/60 hover:bg-red-500/20 hover:text-red-500 dark:border-white/20 dark:bg-white/10 dark:text-white dark:hover:text-red-300"
      >
        Sign out
      </button>
    </form>
  </div>
</div>
