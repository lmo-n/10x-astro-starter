---
import AppLayout from "@/layouts/AppLayout.astro";
import DashboardHeader from "@/components/DashboardHeader.astro";
import FlashcardList from "@/components/FlashcardList.tsx";
import { createClient } from "@/lib/supabase";
import { getDeck, DeckServiceError } from "@/lib/services/deck.service";
import { getFlashcards } from "@/lib/services/flashcard.service";
import { deckIdParamSchema } from "@/lib/validation/decks";
import type { DeckDto, FlashcardDto } from "@/types";

const { user } = Astro.locals;

// Validate the `deckId` path parameter as a UUID.
const params = deckIdParamSchema.safeParse(Astro.params);

let deck: DeckDto | null = null;
let flashcards: FlashcardDto[] = [];
let notFound = !params.success;
let fetchError: string | null = null;

if (params.success && user) {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (supabase) {
    try {
      const result = await getDeck(supabase, user.id, params.data.deckId);
      deck = result.deck;
      flashcards = await getFlashcards(supabase, user.id, params.data.deckId);
    } catch (e) {
      if (e instanceof DeckServiceError && e.code === "DECK_NOT_FOUND") {
        notFound = true;
      } else {
        fetchError = e instanceof Error ? e.message : "Failed to load deck.";
      }
    }
  } else {
    fetchError = "The server is not configured correctly.";
  }
}

if (notFound) {
  Astro.response.status = 404;
}
---

<AppLayout title={deck ? deck.name : "Deck"}>
  <DashboardHeader email={user?.email} />

  <!-- Back link under the header -->
  <a
    href="/dashboard"
    class="mb-6 inline-flex items-center gap-1.5 text-sm text-gray-500 transition-colors hover:text-gray-900 dark:text-blue-100/60 dark:hover:text-white"
  >
    <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
    </svg>
    Back to decks
  </a>

  {
    notFound ? (
      <div class="rounded-2xl border border-gray-200 bg-gray-50 px-6 py-12 text-center dark:border-white/10 dark:bg-white/5">
        <h1 class="mb-2 text-xl font-bold text-gray-900 dark:text-white">Deck not found</h1>
        <p class="mb-6 text-sm text-gray-500 dark:text-blue-100/60">
          This deck doesn&apos;t exist or you don&apos;t have access to it.
        </p>
        <a
          href="/dashboard"
          class="inline-flex items-center rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm text-gray-700 transition-colors hover:bg-gray-50 dark:border-white/20 dark:bg-white/10 dark:text-white dark:hover:bg-white/20"
        >
          Back to decks
        </a>
      </div>
    ) : fetchError ? (
      <div class="rounded-xl border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-600 dark:border-red-400/30 dark:bg-red-500/10 dark:text-red-300">
        {fetchError}
      </div>
    ) : (
      deck && (
        <>
          {/* Flashcards list — includes live deck header with counts */}
          <FlashcardList
            client:load
            deckId={deck.id}
            deckName={deck.name}
            updatedAt={deck.updatedAt}
            initialFlashcards={flashcards}
          />
        </>
      )
    )
  }
</AppLayout>
