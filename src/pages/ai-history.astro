---
import AppLayout from "@/layouts/AppLayout.astro";
import DashboardHeader from "@/components/DashboardHeader.astro";
import BackLink from "@/components/BackLink.astro";
import AiGenerationHistory from "@/components/AiGenerationHistory.tsx";
import AnalyticsSummary from "@/components/AnalyticsSummary.astro";
import { createClient } from "@/lib/supabase";
import { listGenerationLogs, getAnalyticsSummary } from "@/lib/services/ai.service";
import { getAvatarUrl } from "@/lib/utils";
import type { AiGenerationLogListItemDto, AnalyticsSummaryDto, PaginationDto } from "@/types";

const { user } = Astro.locals;
const avatarUrl = getAvatarUrl(user);

let initialLogs: AiGenerationLogListItemDto[] = [];
let initialPagination: PaginationDto = { nextCursor: null, hasMore: false };
let analyticsData: AnalyticsSummaryDto | null = null;

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (supabase && user) {
  const [logsResult, analyticsResult] = await Promise.allSettled([
    listGenerationLogs(supabase, user.id, { limit: 20, sort: "createdAt", order: "desc" }),
    getAnalyticsSummary(supabase, user.id, {}),
  ]);
  if (logsResult.status === "fulfilled") {
    initialLogs = logsResult.value.data;
    initialPagination = logsResult.value.pagination;
  }
  if (analyticsResult.status === "fulfilled") {
    analyticsData = analyticsResult.value.analytics;
  }
}
---

<AppLayout title="AI Generation History">
  <DashboardHeader email={user?.email} avatarUrl={avatarUrl} />
  <BackLink />
  <div class="mb-6">
    <h2 class="text-xl font-bold text-gray-900 dark:text-white">AI Generation History</h2>
    <p class="mt-1 text-sm text-gray-500 dark:text-blue-100/60">
      A log of all your AI flashcard generation sessions with acceptance rate metrics.
    </p>
  </div>
  {analyticsData && <AnalyticsSummary data={analyticsData} />}
  <AiGenerationHistory client:load initialLogs={initialLogs} initialPagination={initialPagination} />
</AppLayout>
