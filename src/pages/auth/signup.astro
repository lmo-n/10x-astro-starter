---
import Layout from "@/layouts/Layout.astro";
import AuthCard from "@/components/auth/AuthCard.astro";
import SignUpForm from "@/components/auth/SignUpForm";
import GoogleSignInButton from "@/components/auth/GoogleSignInButton.astro";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Sign up">
  <AuthCard>
    <h1
      class="mb-6 bg-linear-to-r from-blue-600 to-purple-600 bg-clip-text text-center text-2xl font-bold text-transparent dark:from-blue-200 dark:to-purple-200"
    >
      Sign up
    </h1>
    <GoogleSignInButton label="Sign up with Google" />
    <SignUpForm serverError={error} client:load />
    <p class="mt-4 text-center text-sm text-gray-500 dark:text-blue-100/60">
      Already have an account? <a href="/auth/signin" class="text-purple-600 hover:underline dark:text-purple-300"
        >Sign in</a
      >
    </p>
  </AuthCard>
</Layout>
