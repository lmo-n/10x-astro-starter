---
import AppLayout from "@/layouts/AppLayout.astro";
import DashboardHeader from "@/components/DashboardHeader.astro";
import StudySession from "@/components/StudySession.tsx";
import { createClient } from "@/lib/supabase";
import { getDueStudyQueue, StudyServiceError } from "@/lib/services/study.service";
import { studyDueQuerySchema } from "@/lib/validation/study";

const { user } = Astro.locals;

// Parse the query string (e.g. `?deckId=…`); ignore empty values like the other
// list pages. Invalid params surface as a friendly error rather than a crash.
const rawParams = Object.fromEntries([...Astro.url.searchParams].filter(([, v]) => v !== ""));
const parsed = studyDueQuerySchema.safeParse(rawParams);

const supabase = createClient(Astro.request.headers, Astro.cookies);

let result: Awaited<ReturnType<typeof getDueStudyQueue>> | null = null;
let fetchError: string | null = null;

if (!parsed.success) {
  fetchError = "Invalid study queue parameters.";
} else if (!supabase) {
  fetchError = "The server is not configured correctly.";
} else if (user) {
  try {
    result = await getDueStudyQueue(supabase, user.id, parsed.data);
  } catch (e) {
    if (e instanceof StudyServiceError && e.code === "DECK_NOT_FOUND") {
      fetchError = "That deck doesn't exist or you don't have access to it.";
    } else {
      fetchError = e instanceof Error ? e.message : "Failed to load the study queue.";
    }
  }
}

const items = result?.data ?? [];
const summary = result?.summary ?? { dueCount: 0, suggestedTodayCount: 0, upcomingCount: 0 };
const nextCursor = result?.pagination.nextCursor ?? null;
const deckId = parsed.success ? parsed.data.deckId : undefined;
---

<AppLayout title="Study">
  <DashboardHeader email={user?.email} />

  <!-- Back link under the header -->
  <a
    href="/dashboard"
    class="mb-6 inline-flex items-center gap-1.5 text-sm text-gray-500 transition-colors hover:text-gray-900 dark:text-blue-100/60 dark:hover:text-white"
  >
    <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
    </svg>
    Back to decks
  </a>

  <div class="mb-8">
    <h1
      class="bg-linear-to-r from-blue-600 to-purple-600 bg-clip-text text-2xl font-bold text-transparent sm:text-3xl dark:from-blue-200 dark:to-purple-200"
    >
      Study
    </h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-blue-100/60">Review the flashcards that are due today.</p>
  </div>

  <StudySession
    client:load
    initialItems={items}
    summary={summary}
    initialNextCursor={nextCursor}
    deckId={deckId}
    fetchError={fetchError}
  />
</AppLayout>
