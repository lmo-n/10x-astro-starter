---
import AppLayout from "@/layouts/AppLayout.astro";
import DashboardHeader from "@/components/DashboardHeader.astro";
import DeckList from "@/components/DeckList.astro";
import ProfileStats from "@/components/ProfileStats.astro";
import AiGenerationHistory from "@/components/AiGenerationHistory.tsx";
import { createClient } from "@/lib/supabase";
import { getDueStudyQueue } from "@/lib/services/study.service";
import { getProfile } from "@/lib/services/profile.service";
import { getAvatarUrl } from "@/lib/utils";
import type { GetProfileResponseDto } from "@/types";

const { user } = Astro.locals;
const avatarUrl = getAvatarUrl(user);

const supabase = createClient(Astro.request.headers, Astro.cookies);
let dueCount = 0;
let profileData: GetProfileResponseDto | null = null;
if (supabase && user) {
  const [studyResult, profileResult] = await Promise.allSettled([
    getDueStudyQueue(supabase, user.id, { limit: 1, includeFuturePreview: false }),
    getProfile(supabase, user.id),
  ]);
  if (studyResult.status === "fulfilled") {
    dueCount = studyResult.value.summary.dueCount;
  }
  if (profileResult.status === "fulfilled") {
    profileData = profileResult.value;
  }
}
---

<AppLayout title="Dashboard">
  <DashboardHeader email={user?.email} avatarUrl={avatarUrl} />
  {profileData && <ProfileStats data={profileData} />}
  <AiGenerationHistory client:load />
  <div class="mb-6 flex items-center justify-between gap-4">
    <h2 class="text-sm font-semibold text-gray-900 dark:text-white">My Decks</h2>
    {
      dueCount > 0 ? (
        <a
          href="/study"
          class="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-blue-700 dark:bg-blue-500/80 dark:hover:bg-blue-500"
        >
          <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
            />
          </svg>
          Study now
          <span class="rounded-full bg-white/20 px-1.5 py-0.5 text-xs font-semibold tabular-nums">{dueCount}</span>
        </a>
      ) : (
        <span class="inline-flex items-center gap-1.5 text-xs text-gray-400 dark:text-blue-100/40">
          <svg
            class="h-3.5 w-3.5 text-green-500 dark:text-green-400"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
          All caught up
        </span>
      )
    }
  </div>
  <DeckList />
</AppLayout>
